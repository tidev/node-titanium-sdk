{
  "name": "node-titanium-sdk",
  "version": "7.0.0",
  "description": "Titanium SDK Library",
  "keywords": [
    "mobile",
    "tidev",
    "titanium",
    "titanium-sdk"
  ],
  "homepage": "https://github.com/tidev/node-titanium-sdk",
  "bugs": "https://github.com/tidev/node-titanium-sdk/issues",
  "license": "Apache-2.0",
  "author": "TiDev, Inc. <npm@tidev.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/tidev/node-titanium-sdk"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./android": {
      "types": "./dist/android/index.d.mts",
      "import": "./dist/android/index.mjs",
      "default": "./dist/android/index.mjs"
    },
    "./jdk": {
      "types": "./dist/jdk/index.d.mts",
      "import": "./dist/jdk/index.mjs",
      "default": "./dist/jdk/index.mjs"
    },
    "./titanium": {
      "types": "./dist/titanium/index.d.mts",
      "import": "./dist/titanium/index.mjs",
      "default": "./dist/titanium/index.mjs"
    },
    "./util": {
      "types": "./dist/util/index.d.mts",
      "import": "./dist/util/index.mjs",
      "default": "./dist/util/index.mjs"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsdown -c tsdown.config.ts",
    "check": "pnpm type-check && pnpm lint && pnpm fmt:check",
    "coverage": "vitest --coverage",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "cross-env CI=1 vitest",
    "test:bun": "cross-env CI=1 bun --bun --config=bunfig.toml ./node_modules/vitest/vitest.mjs --reporter=verbose",
    "test:deno": "cross-env CI=1 deno run --allow-all --sloppy-imports ./node_modules/vitest/vitest.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "8.0.1",
    "@babel/parser": "8.0.4",
    "@babel/plugin-transform-property-literals": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@xmldom/xmldom": "0.9.10",
    "babel-plugin-transform-titanium": "0.1.1",
    "babel-preset-minify": "0.5.2",
    "semver": "7.8.5",
    "simple-plist": "1.3.1",
    "snooplogg": "9.0.0",
    "stream-splitter": "0.3.2",
    "undici": "8.8.0",
    "which": "7.0.0",
    "yauzl": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-tester": "12.0.0",
    "cross-env": "10.1.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "proxy": "4.1.0",
    "rimraf": "6.1.3",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
