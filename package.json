{
  "name": "node-titanium-sdk",
  "version": "7.0.0",
  "author": "TiDev, Inc. <npm@tidev.io>",
  "description": "Titanium SDK Library",
  "type": "module",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.js",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "license": "Apache-2.0",
  "keywords": [
    "titanium",
    "titanium-sdk",
    "tidev",
    "mobile"
  ],
  "files": [
    "bin",
    "dist"
  ],
  "dependencies": {
    "@babel/core": "7.28.5",
    "@babel/parser": "7.28.5",
    "@babel/plugin-transform-property-literals": "7.27.1",
    "@babel/preset-env": "7.28.5",
    "@xmldom/xmldom": "0.8.11",
    "babel-plugin-transform-titanium": "0.1.1",
    "babel-preset-minify": "0.5.2",
    "snooplogg": "6.1.1",
    "stream-splitter": "0.3.2",
    "which": "6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "babel-plugin-tester": "12.0.0",
    "dprint": "0.51.1",
    "lefthook": "2.0.13",
    "oxlint": "1.36.0",
    "rimraf": "6.1.2",
    "semver": "7.7.3",
    "tsdown": "0.18.3",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "homepage": "https://github.com/tidev/node-titanium-sdk",
  "bugs": "https://github.com/tidev/node-titanium-sdk/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/tidev/node-titanium-sdk"
  },
  "scripts": {
    "build": "rimraf dist && tsdown -c tsdown.config.ts",
    "check": "pnpm type-check && pnpm lint",
    "coverage": "vitest --coverage",
    "format": "dprint fmt",
    "lint": "oxlint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest",
    "test:bun": "bun --bun test --config=bunfig.toml",
    "test:deno": "deno run --allow-all --sloppy-imports ./node_modules/vitest/vitest.mjs",
    "type-check": "tsc --noEmit"
  }
}
